# Copiez ce fichier en « .env » et adaptez les valeurs.
# ----------------------------------------------------------------------

# Clé secrète Flask (sessions, connexion admin). Mettez une longue chaîne aléatoire.
SECRET_KEY=changez-moi-par-une-longue-chaine-aleatoire

# Base de données.
#  - En LOCAL (Windows), laissez vide : on utilise automatiquement SQLite (instance/cms.db).
#  - En PRODUCTION cPanel, renseignez la base MySQL créée dans cPanel :
# DATABASE_URL=mysql+pymysql://UTILISATEUR:MOTDEPASSE@localhost/NOMBASE
DATABASE_URL=

# URL publique du site (sert à générer canonical, hreflang, Open Graph…).
SITE_URL=https://africagovernanceinstitute.org

# Dossier de sortie du site généré (ce qui ira dans public_html sur cPanel).
OUTPUT_DIR=../public
