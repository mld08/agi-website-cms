# Copiez ce fichier en « .env » et adaptez les valeurs.
# ----------------------------------------------------------------------

# Clé secrète Flask (sessions, connexion admin). Mettez une longue chaîne aléatoire.
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi-par-une-longue-chaine-aleatoire

# Base de données.
#  - En LOCAL (Windows), laissez vide : SQLite automatique (instance/cms.db).
#  - En PRODUCTION cPanel (MySQL). NOTE: cPanel préfixe la base et l'utilisateur
#    par votre nom de compte (ex. moncompte_agicms). Gardez ?charset=utf8mb4 pour
#    les accents.
# DATABASE_URL=mysql+pymysql://COMPTE_agicms:MOTDEPASSE@localhost/COMPTE_agicms?charset=utf8mb4
DATABASE_URL=

# URL publique du site (canonical, hreflang, Open Graph…).
SITE_URL=https://africagovernanceinstitute.org

# Dossier de SORTIE du site généré.
#  - En local : ../public (défaut).
#  - En PRODUCTION : le public_html du domaine principal (chemin ABSOLU).
# OUTPUT_DIR=/home/COMPTE/public_html
OUTPUT_DIR=

# Dossier du SITE D'ORIGINE (design source : en/, fr/, assets/, css, js).
#  - En local : ../template (défaut).
#  - En PRODUCTION : où vous l'avez téléversé (chemin ABSOLU).
# TEMPLATE_DIR=/home/COMPTE/template
TEMPLATE_DIR=

# ----- Installation sans terminal (page web /setup) -----
# Jeton secret qui active la page https://cms.../setup/<JETON>.
# Renseignez-le pour installer, puis VIDEZ-LE et redémarrez l'app pour désactiver.
# SETUP_TOKEN=un-long-jeton-secret-aleatoire
SETUP_TOKEN=

# Identifiants du premier compte admin, créés par la page /setup.
# ADMIN_EMAIL=vous@exemple.com
# ADMIN_PASSWORD=UnMotDePasseFort
ADMIN_EMAIL=
ADMIN_PASSWORD=
