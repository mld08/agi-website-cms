# Africa Governance Institute — server config

# Serve the custom, branded error pages instead of the server defaults.
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html
ErrorDocument 500 /500.html

# Don't expose directory listings.
Options -Indexes

# =========================================================
#  Defence in depth: never serve internal/working files.
#  (These should also be excluded from the deploy build.)
# =========================================================
<FilesMatch "\.(md|map)$">
  Require all denied
</FilesMatch>
<Files ".thumbnail">
  Require all denied
</Files>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(screenshots|uploads)/ - [R=404,L]
</IfModule>

# UTF-8 by default for text.
AddDefaultCharset utf-8

# =========================================================
#  Canonicalisation: force HTTPS + a single (non-www) host,
#  and strip /index.html so every page has one URL.
# =========================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP -> HTTPS and www -> non-www, in a single 301.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # /path/index.html -> /path/  (canonical directory form)
  RewriteCond %{THE_REQUEST} \s/+(.+/)?index\.html[\s?] [NC]
  RewriteRule ^(.+/)?index\.html$ /$1 [R=301,L]
</IfModule>

# =========================================================
#  Compression
# =========================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml \
    application/rss+xml application/atom+xml font/woff2
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# =========================================================
#  Browser cache
# =========================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Long-lived, immutable static assets (they are query-string versioned).
  <FilesMatch "\.(avif|webp|jpe?g|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Security / trust signals
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Content Security Policy.
  # Scripts and fonts are same-origin. The only third parties are the mapping /
  # charting CDNs used by the US-tariffs analysis (Leaflet on unpkg, Chart.js on
  # jsDelivr) and the click-to-load YouTube (nocookie) and OpenStreetMap embeds.
  # No inline <script> is used anywhere; inline styles (style attributes, Leaflet)
  # are allowed via 'unsafe-inline' in style-src only.
  # Tip: to dry-run changes, swap the header name for Content-Security-Policy-Report-Only.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' https://unpkg.com 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; frame-src https://www.youtube-nocookie.com https://www.openstreetmap.org; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
